{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crashlytics-slack",
	"main": "src/index.js",
	"compatibility_date": "2026-10-07",
	"workers_dev": true,
	"vars": {
		"GITHUB_OWNER": "hoang6845",
		"GITHUB_REPO": "crashlystic_bot",
		"GITHUB_REF": "main",
		"SLACK_TEAM_ID": "T08K37R1404",
		"SLACK_ALLOWED_USER_IDS": "*",
		"MAX_MANUAL_REPORTS_PER_DAY": "5",
		"CLOUD_REPORT_ENABLED": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crashlytics-requests",
			"database_id": "926d1d13-5188-4c91-9478-37c437f19194"
		}
	]
}